# GitHub OAuth Integration
# Get these from GitHub Developer Settings -> OAuth Apps
VITE_GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Deployment
DEPLOY_PASSWORD=your_password_here
DEPLOY_HOST=your_host_ip
DEPLOY_USER=root
DEPLOY_PATH=/opt/dzikr-dua

# Formbricks
VITE_FORMBRICKS_ENVIRONMENT_ID=your_environment_id
VITE_FORMBRICKS_API_HOST=https://your-formbricks-domain.com

# Formbricks Self-Hosting (Infrastructure)
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
# Generate ENCRYPTION_KEY: openssl rand -hex 32
FORMBRICKS_DB_PASSWORD=super_secure_password
FORMBRICKS_WEBAPP_URL=https://your-formbricks-domain.com
FORMBRICKS_NEXTAUTH_SECRET=
FORMBRICKS_ENCRYPTION_KEY=
